APP_NAME="VAPT Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vapt_platform
DB_USERNAME=vapt_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=2100
VAPT_HTTP_PROXY=

CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- VAPT hard safety ceilings ---
VAPT_MAX_REQUEST_RATE=20
VAPT_MAX_CONCURRENCY=25
VAPT_MAX_DURATION_SECONDS=600
VAPT_MAX_TOTAL_REQUESTS=50000
VAPT_MAX_ERROR_RATE_PERCENT=25
VAPT_MAX_LATENCY_MS=10000
VAPT_MAX_CRAWL_PAGES=100

# Optional local-only seed; requires a strong password of 16+ characters. Leave blank in shared environments.
VAPT_SEED_EMAIL=analyst@vapt.local
VAPT_SEED_PASSWORD=
